{
  "name": "providencia-ciudadania-lab",
  "version": "0.20.0",
  "private": true,
  "description": "PWA educativa Observatorio Ciudadano — Ovalle 2035. Monorepo.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "functions",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev -w @pclab/web",
    "dev:web": "npm run dev -w @pclab/web",
    "emulator": "firebase emulators:start",
    "emulator:only": "firebase emulators:start --only auth,firestore,functions",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --exclude 'tests/**'",
    "test:unit": "vitest run --exclude 'tests/**'",
    "test:rules": "vitest run tests/rules",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "npm run build:web && npm run build:functions && npm run typecheck:server",
    "build:web": "npm run build -w @pclab/web",
    "bundle:functions": "esbuild functions/src/index.ts --bundle --platform=node --format=cjs --outfile=functions/dist/index.js --external:firebase-admin --external:firebase-functions --external:pdfkit --alias:@pclab/shared=./packages/shared/src/index.ts --alias:@pclab/domain=./packages/domain/src/index.ts --alias:@pclab/application=./packages/application/src/index.ts --alias:@pclab/infrastructure=./packages/infrastructure/src/index.ts --sourcemap",
    "build:functions": "npm run bundle:functions",
    "seed:courses": "tsx scripts/src/seed-courses.ts",
    "seed:content": "tsx scripts/src/seed-content.ts",
    "seed:demo-teacher": "tsx scripts/src/seed-demo-teacher.ts",
    "seed:demo-student": "tsx scripts/src/seed-demo-student.ts",
    "seed:demo-evaluator": "tsx scripts/src/seed-demo-evaluator.ts",
    "seed:demo-pie": "tsx scripts/src/seed-demo-pie.ts",
    "seed:demo-utp": "tsx scripts/src/seed-demo-utp.ts",
    "seed:students-auth": "tsx scripts/src/seed-students-auth.ts",
    "import:students": "tsx scripts/src/import-students.ts",
    "import:students:dry": "tsx scripts/src/import-students.ts --dry-run",
    "analyze:roster": "tsx scripts/src/analyze-roster.ts",
    "verify:farm": "tsx scripts/src/verify-farm.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@esbuild/win32-x64": "0.24.2",
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "0.24.2",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.1",
    "firebase-tools": "^13.29.3",
    "jsdom": "^25.0.1",
    "pinia": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0",
    "xlsx": "^0.18.5"
  }
}
