# ==============================================================
# Providencia Ciudadanía Lab — variables de entorno (copiar a .env)
# NUNCA commitear los valores reales. Copiar a .env.development
# / .env.test / .env.staging / .env.production según entorno.
# ==============================================================

# --- Frontend (apps/web) ---
# Identifican el proyecto Firebase (públicas por diseño, no secretas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ciudadania-lab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ciudadania-lab
VITE_FIREBASE_STORAGE_BUCKET=ciudadania-lab.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# true para apuntar a Emulator Suite en desarrollo
VITE_USE_EMULATORS=true

# --- Server / scripts / functions ---
GCLOUD_PROJECT=ciudadania-lab
# Cuando el emulador está activo, el admin SDK usa estos hosts
# (puertos propios del proyecto; 8080/9099 pueden estar ocupados por otros emuladores)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9200
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5002
# Ruta a archivos privados de nóminas (ignorados por git)
PCLAB_PRIVATE_DATA=./private-data
