rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Archivos de evidencia subidos por estudiantes
    match /submissions/{studentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('text/plain');
      allow delete: if request.auth != null && request.auth.uid == studentId;
    }

    // Materiales didácticos (profesor/evaluador)
    match /materials/{materialId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.token.role in ['MASTER', 'ADMIN', 'PROFESOR']
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
